# ─── Wishly production env ────────────────────────────────────────────────
# Copy to .env.production and fill in real values before `docker-compose -f docker-compose.prod.yml up`.

# ─── Database ─────────────────────────────────────────────────────────────
POSTGRES_USER="wishly"
POSTGRES_PASSWORD="CHANGEME_strong_random_string_32+chars"
POSTGRES_DB="wishly"

# ─── App URLs (must match your real domain) ──────────────────────────────
WEB_URL="https://wishly.app"
API_URL="https://api.wishly.app/api/v1"
NEXT_PUBLIC_API_URL="https://api.wishly.app/api/v1"
NEXT_PUBLIC_SITE_URL="https://wishly.app"

# ─── Auth ────────────────────────────────────────────────────────────────
JWT_SECRET="CHANGEME_32+char_random_for_api_jwt"
JWT_REFRESH_SECRET="CHANGEME_another_32+char_random"
NEXTAUTH_URL="https://wishly.app"
NEXTAUTH_SECRET="CHANGEME_32+char_random_for_nextauth"

# Google OAuth (optional — for authenticated users)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Telegram (required for bot + TG Stars + push reminders) ─────────────
TELEGRAM_BOT_TOKEN=""              # From @BotFather
BOT_WEBHOOK_SECRET=""              # Random 32-char string — must match in bot and API

# ─── Cloudflare R2 (optional — falls back to local FS if absent) ─────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="wishly-uploads"
R2_PUBLIC_URL="https://cdn.wishly.app"

# ─── Optional payment providers (DEFER until needed) ─────────────────────
# We use TG Stars for primary monetization. These are for group-gift Kitty
# escrow if you finish that feature (currently frozen).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
